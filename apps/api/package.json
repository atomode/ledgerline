{
  "name": "@ledgerline/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "OTEL_SERVICE_NAME=ledgerline-api tsx watch --env-file-if-exists=../../.env --import @ledgerline/observability/register src/main.ts",
    "start": "OTEL_SERVICE_NAME=ledgerline-api node --import @ledgerline/observability/register dist/main.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@ledgerline/config": "workspace:*",
    "@ledgerline/contracts": "workspace:*",
    "@ledgerline/db": "workspace:*",
    "@ledgerline/observability": "workspace:*",
    "@ledgerline/queues": "workspace:*",
    "@ledgerline/storage": "workspace:*",
    "bullmq": "^5.63.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  }
}
