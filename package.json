{
  "name": "ledgerline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@ledgerline/api --filter=@ledgerline/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "db:generate": "pnpm --filter @ledgerline/db db:generate",
    "db:migrate": "pnpm --filter @ledgerline/db db:migrate",
    "db:seed": "pnpm --filter @ledgerline/db db:seed",
    "eval": "pnpm --filter @ledgerline/evals eval",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "turbo": "^2.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.0"
  }
}
