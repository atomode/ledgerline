# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://ledgerline:ledgerline@localhost:5432/ledgerline
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=invoices
S3_ACCESS_KEY_ID=ledgerline
S3_SECRET_ACCESS_KEY=ledgerline-local-secret

# Required for extraction and evals; tests never call the real API.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5
CLASSIFY_MODEL=claude-haiku-5-5
# Input-tokens-per-minute budget shared by all workers (size to your Anthropic tier).
ANTHROPIC_ITPM_BUDGET=400000

API_HOST=0.0.0.0
API_PORT=3000

WEBHOOK_SIGNING_SECRET=change-me-to-a-long-random-string
CURSOR_SIGNING_SECRET=change-me-to-another-long-random-string

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
