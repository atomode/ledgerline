{
  "name": "@ledgerline/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "db:backfill:money": "tsx --env-file-if-exists=../../.env scripts/backfill-money-minor.ts"
  },
  "dependencies": {
    "@ledgerline/config": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0",
    "uuid": "^14.0.3",
    "@ledgerline/contracts": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "@ledgerline/matching": "workspace:*"
  }
}
