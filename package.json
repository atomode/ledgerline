{
  "name": "ledgerline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@ledgerline/api --filter=@ledgerline/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "db:generate": "pnpm --filter @ledgerline/db db:generate",
    "db:migrate": "pnpm --filter @ledgerline/db db:migrate",
    "db:seed": "pnpm --filter @ledgerline/db db:seed",
    "eval": "pnpm --filter @ledgerline/evals eval",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "contracts:generate": "turbo run build --filter=@ledgerline/api... && tsx apps/api/scripts/generate-openapi.ts && openapi-typescript packages/contracts/openapi.yaml -o packages/contracts/src/client/schema.gen.ts && prettier --write packages/contracts/src/client/schema.gen.ts >/dev/null",
    "contracts:check": "turbo run build --filter=@ledgerline/api... && tsx apps/api/scripts/generate-openapi.ts --check && openapi-typescript packages/contracts/openapi.yaml -o /tmp/ledgerline-schema.gen.ts && prettier --stdin-filepath x.ts < /tmp/ledgerline-schema.gen.ts | diff -q - packages/contracts/src/client/schema.gen.ts && redocly lint packages/contracts/openapi.yaml",
    "db:backfill:money": "pnpm --filter @ledgerline/db db:backfill:money",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@ledgerline/db": "workspace:*",
    "@redocly/cli": "^2.80.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "ioredis": "^5.11.1",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.6.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.0"
  }
}
